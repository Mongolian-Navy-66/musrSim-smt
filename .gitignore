# Generated data: local only; keep curated exceptions below.
*.root
*.dat
*.bin
*.npz
*.npy
*.pkl
*.pickle
*.h5
*.hdf5
*.wrl

# Compiler, ROOT dictionary and Python artifacts.
*.o
*.obj
*.so
*.a
*.dll
*.dylib
*.exe
*.pcm
*.d
*.pyc
*.pyo
**/__pycache__/**
**/.pytest_cache/**
**/.mypy_cache/**
**/.ruff_cache/**
**/CMakeFiles/**
/build/**
/cmake-build-*/**
/install/**
/.venv/**
/venv/**
/.cache/**
/.idea/**
/.vscode/**
/.obsidian/**

# Runtime logs and TeX intermediates (formal PDFs and TeX sources are allowed).
*.log
*.err
*.out
*.exitcode
*.aux
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.nav
*.snm
*.vrb
*.swp
*.swo
*~

# Local credentials; example environment files may be published.
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
id_rsa
id_ed25519
.credentials

# Runtime/generated directories. Explicit curated paths reopen parents below.
**/logs/**
**/logs_*/**
**/work/**
**/work_*/**
**/scratch/**
**/scratch_*/**

# Reproducible source bundles are normally kept locally.
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# Project-specific local output exclusions.
/build/
/cmake-build-*/
/install/
/.idea/
/.vscode/
/run/multiSimuScript/
/run/multiSimuScript/**

# Curated publication allowlist: exact files; regenerate audit when reports change.
!/CONTRIBUTING.md
!/COPYING
!/FindROOT.cmake
!/LICENSE
!/NOTICE.md
!/README.md
!/README.zh-CN.md
!/docs/
!/docs/upstream/
